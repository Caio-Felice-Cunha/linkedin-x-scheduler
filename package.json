{
  "name": "linkedin-x-scheduler",
  "version": "0.1.0",
  "description": "Bulk-schedule a week of LinkedIn and X (Twitter) posts from your own logged-in Chrome — no API keys, no OAuth, no SaaS. Attaches over the Chrome DevTools Protocol and drives the native Schedule UI.",
  "license": "MIT",
  "author": "Caio Di Felice Cunha",
  "homepage": "https://github.com/Caio-Felice-Cunha/linkedin-x-scheduler#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Caio-Felice-Cunha/linkedin-x-scheduler.git"
  },
  "bugs": {
    "url": "https://github.com/Caio-Felice-Cunha/linkedin-x-scheduler/issues"
  },
  "keywords": [
    "linkedin",
    "twitter",
    "x",
    "scheduler",
    "social-media",
    "playwright",
    "cdp",
    "chrome-devtools-protocol",
    "automation",
    "no-api",
    "content-scheduling"
  ],
  "type": "commonjs",
  "main": "src/cli.js",
  "bin": {
    "linkedin-x-scheduler": "src/cli.js"
  },
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "schedule": "node src/cli.js",
    "demo": "node src/cli.js demo --batch examples/sample-batch --output site",
    "dry-run": "node src/cli.js --dry-run",
    "connect-check": "node src/cli.js connect-check",
    "gen-sample": "node examples/sample-batch/generate-placeholders.js",
    "test": "node tests/scheduler.test.js && node --test tests/demo.test.js"
  },
  "dependencies": {
    "playwright-core": "^1.44.0"
  },
  "engines": {
    "node": ">=18"
  }
}
